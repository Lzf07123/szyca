# 复制为 .env 使用（.env 不入库）。以下均为占位默认值，无任何真实配置。
ADMIN_PASSWORD=admin123
# PostgreSQL 由单容器内部管理，默认仅在容器回环地址暴露。
POSTGRES_PASSWORD=quiz
QUESTION_SECONDS=20
# 网络抖动/断线补交宽限；服务端仍以 QUESTION_SECONDS 判定本题截止时间。
ANSWER_GRACE_SECONDS=20
QUESTION_COUNT=10
WEB_PORT=8080
PG_POOL_MAX=20
# 额外允许的 WebSocket Origin（逗号分隔）；同源和本机开发默认允许。
#WS_ALLOWED_ORIGINS=https://quiz.example.com

# 远程应用镜像：最终地址 = QUIZ_IMAGE_REGISTRY + QUIZ_IMAGE
# 该前缀独立于本地构建基础镜像，不会读取 BASE_IMAGE_REGISTRY。
# 例：QUIZ_IMAGE_REGISTRY=registry.example.com/ QUIZ_IMAGE=szyca:latest
#QUIZ_IMAGE_REGISTRY=docker.1ms.run/
QUIZ_IMAGE=szyca:latest
QUIZ_PULL_POLICY=missing

# 仅开发构建时生效：构建基础镜像前缀、软件源。
# 生产低配机器只执行 docker compose pull/up，不使用这两个变量。
#BASE_IMAGE_REGISTRY=docker.1ms.run/
#SOURCE_MIRROR=cn
