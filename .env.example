# 复制为 .env 使用（.env 不入库）。以下均为占位默认值，无任何真实配置。
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=owner
# 仅本机 HTTP 调试使用 false；生产 HTTPS 必须设为 true。
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=8
# 仅旧口令迁移窗口临时开启；完成 owner 账号接管后保持 false。
LEGACY_ADMIN_TOKEN_ENABLED=false
# PostgreSQL 由单容器内部管理，默认仅在容器回环地址暴露。
POSTGRES_PASSWORD=szyca
QUESTION_SECONDS=20
# 网络抖动/断线补交宽限；服务端仍以 QUESTION_SECONDS 判定本题截止时间。
ANSWER_GRACE_SECONDS=20
QUESTION_COUNT=10
WEB_PORT=8080
PG_POOL_MAX=20
# 仅这些代理来源允许透传 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# 额外允许的 WebSocket Origin（逗号分隔）；同源和本机开发默认允许。
#WS_ALLOWED_ORIGINS=https://szyca.example.com

# 远程应用镜像：最终地址 = SZYCA_IMAGE_REGISTRY + SZYCA_IMAGE
# 该前缀独立于本地构建基础镜像，不会读取 BASE_IMAGE_REGISTRY。
# 例：SZYCA_IMAGE_REGISTRY=registry.example.com/ SZYCA_IMAGE=szyca:latest
#SZYCA_IMAGE_REGISTRY=docker.1ms.run/
SZYCA_IMAGE=szyca:latest
SZYCA_PULL_POLICY=missing

# 仅开发构建时生效：构建基础镜像前缀、软件源。
# 生产低配机器只执行 docker compose pull/up，不使用这两个变量。
#BASE_IMAGE_REGISTRY=docker.1ms.run/
#SOURCE_MIRROR=cn
