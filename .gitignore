# 敏感信息
.env
.env.*
!.env.example

# 依赖与构建产物
node_modules/
dist/
build/
bin/
vendor/
*.local
/server

# Go 测试与覆盖率
*.test
*.out
coverage.*

# 日志与临时文件
*.log
.DS_Store
Thumbs.db
*.swp
tmp/
coverage/

# Python 测试缓存
__pycache__/
*.py[cod]
.pytest_cache/

# Playwright 默认产物
playwright-report/
test-results/

# 题库数据（通过后台导入，不进入源码仓库）
题库/

